---
import Base from '../layouts/Base.astro';

const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
const title = lang === 'fr' ? '404 — Page non trouvée' : '404 — Page Not Found';
const description = lang === 'fr' ? 'La page que vous cherchez n\'existe pas.' : 'The page you are looking for does not exist.';

const alternates = {
  fr: '/',
  en: '/en/',
};
---

<Base {lang} {title} {description} {alternates} noindex>
  <main>
    <div class="content">
      <h1>404</h1>
      <p class="note fr">cellule morte.</p>
      <p class="msg fr">La page que vous cherchez n'existe pas.</p>
      <a href="/" class="back">Retour</a>

      <hr />

      <h2>404</h2>
      <p class="note en">dead cell.</p>
      <p class="msg en">The page you are looking for does not exist.</p>
      <a href="/en/" class="back">Back</a>
    </div>
  </main>
</Base>

<style>
  main {
    height: 100%;
    overflow: auto;
    background: var(--paper);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
    background-attachment: local;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    padding: 6vh 4vw;
    text-align: center;
  }

  h1 {
    font: clamp(48px, 10vw, 96px)/.9 'Geist Pixel';
    font-weight: 400;
    margin: 0 0 18px;
    color: var(--ink);
  }

  h2 {
    font: clamp(32px, 6vw, 48px)/.9 'Geist Pixel';
    font-weight: 400;
    margin: 28px 0 18px;
    color: var(--ink);
  }

  .note {
    font-family: 'Shantell Sans', cursive;
    font-size: clamp(18px, 4vw, 24px);
    color: var(--accent);
    margin: 0 0 12px;
    display: block;
  }

  .msg {
    font-family: 'Gambarino', serif;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.4;
    color: var(--ink);
    margin: 0 0 18px;
    max-width: 40ch;
  }

  .back {
    display: inline-block;
    padding: 4px 8px;
    border: 1px solid var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--ink);
    background: var(--paper);
    font-size: 12px;
  }

  .back:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  hr {
    width: 60%;
    height: 1px;
    border: none;
    background: var(--line);
    margin: 28px 0;
  }

  .fr + .msg.fr,
  .en + .msg.en {
    margin-bottom: 18px;
  }
</style>
