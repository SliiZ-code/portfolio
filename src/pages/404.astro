---
import Base from '../layouts/Base.astro';

// Determine language based on URL
const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith('/en/');
const lang = isEnglish ? 'en' : 'fr';

const title = lang === 'fr' ? '404 — Page non trouvée' : '404 — Page Not Found';
const description = lang === 'fr' ? 'La page que vous cherchez n\'existe pas.' : 'The page you are looking for does not exist.';

const alternates = {
  fr: '/',
  en: '/en/',
};
---

<Base {lang} {title} {description} {alternates}>
  <main style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem; font-family: 'Gambarino', serif;">
    <div style="text-align: center; max-width: 600px;">
      <!-- French section -->
      <div style="margin-bottom: 4rem;">
        <h1 style="font-family: 'Geist Pixel', monospace; font-size: 6rem; margin: 0; line-height: 1; color: var(--color-ink);">404</h1>
        <p style="font-family: 'Shantell Sans', cursive; font-size: 1.5rem; margin: 1rem 0 0 0; color: var(--color-ink);">cellule morte</p>
        <p style="font-size: 1rem; color: var(--color-ink); margin: 1.5rem 0 0 0;">La page que vous cherchez n'existe pas.</p>
        <a href="/" style="display: inline-block; margin-top: 1.5rem; padding: 0.5rem 1rem; background: var(--color-accent); color: var(--color-bg); text-decoration: none; border-radius: 0.25rem; font-family: 'Geist Mono', monospace;">Retour</a>
      </div>

      <!-- English section -->
      <div style="border-top: 1px solid var(--color-ink-faint); padding-top: 2rem;">
        <h2 style="font-family: 'Geist Pixel', monospace; font-size: 2rem; margin: 0 0 0.5rem 0; line-height: 1; color: var(--color-ink);">404</h2>
        <p style="font-family: 'Shantell Sans', cursive; font-size: 1.5rem; margin: 0.5rem 0 0 0; color: var(--color-ink);">dead cell</p>
        <p style="font-size: 1rem; color: var(--color-ink); margin: 1.5rem 0 0 0;">The page you are looking for does not exist.</p>
        <a href="/en/" style="display: inline-block; margin-top: 1.5rem; padding: 0.5rem 1rem; background: var(--color-accent); color: var(--color-bg); text-decoration: none; border-radius: 0.25rem; font-family: 'Geist Mono', monospace;">Back</a>
      </div>
    </div>
  </main>
</Base>

<style>
  :root[data-theme='paper'] {
    --color-bg: #e8e5dc;
    --color-ink: #1b1a17;
    --color-ink-faint: #d4d1c8;
    --color-accent: #2433ff;
  }

  :root[data-theme='night'] {
    --color-bg: #131210;
    --color-ink: #e8e5dc;
    --color-ink-faint: #4a4845;
    --color-accent: #ff8a3d;
  }

  main {
    background: var(--color-bg);
    color: var(--color-ink);
  }
</style>
