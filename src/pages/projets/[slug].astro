---
import ProjectPage from '../../components/ProjectPage.astro';
import { getResume, type Project } from '../../lib/resume';

export function getStaticPaths() {
  return getResume('fr').projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<ProjectPage lang="fr" project={project} />
