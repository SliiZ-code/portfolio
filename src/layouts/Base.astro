---
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/shantell-sans/400.css';
import '@fontsource/shantell-sans/500.css';
import '../styles/global.css';
import { site } from '../data/site';
import type { Lang } from '../lib/resume';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: { fr: string; en: string };
  zoomable?: boolean;
  noindex?: boolean;
}

const { lang, title, description, alternates, zoomable = false, noindex = false } = Astro.props;
const abs = (path: string) => (site.url ? new URL(path, site.url).href : path);
---

<!doctype html>
<html lang={lang} data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={zoomable ? 'width=device-width, initial-scale=1' : 'width=device-width, initial-scale=1, maximum-scale=1'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {!noindex && (
      <>
        <link rel="canonical" href={abs(Astro.url.pathname)} />
        <link rel="alternate" hreflang="fr" href={abs(alternates.fr)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.fr)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" id="theme-color" content="#e8e5dc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    {!noindex && <meta property="og:url" content={abs(Astro.url.pathname)} />}
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      const initialTheme = (stored, hour) => {
        if (stored === 'night' || stored === 'paper') {
          return stored;
        }
        return hour >= 19 || hour < 7 ? 'night' : 'paper';
      };
      const updateThemeColor = () => {
        const isNight = document.documentElement.dataset.theme === 'night';
        const color = isNight ? '#131210' : '#e8e5dc';
        const el = document.getElementById('theme-color');
        if (el) el.content = color;
      };
      try {
        var stored = localStorage.getItem('jpc-theme');
        var hour = new Date().getHours();
        var theme = initialTheme(stored, hour);
        document.documentElement.dataset.theme = theme;
      } catch (error) {}
      updateThemeColor();
      document.addEventListener('themechange', updateThemeColor);
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { initUI } from '../scripts/ui';
      initUI();
    </script>
  </body>
</html>
