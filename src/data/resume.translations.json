    "d6586ed2d9c48e247848b06f53fa6af367f19b981e0ec4eae2ea3356df7c1706": {
      "en": "<p>Lead developer of Cerebro, an internal tool that matches consultant profiles with client tenders using LLMs.</p><ul><li><p>Designed and put into production an asynchronous AI pipeline for extraction and scoring for tender × profile pairs, processing several hundred records via reliable batch management.</p></li><li><p>Calibrated the scoring prompt (temperature, required or desired skills, three sub-scores) and added short justifications so users can verify each score.</p></li><li><p>Built an annotated benchmark dataset to quantify and reduce the false positive and false negative rates of the scoring system.</p></li><li><p>Automated the generation of daily reports for a team of ten salespeople and secured access to the API and web interface via SSO authentication. Stack: Python, FastAPI, Pydantic, SQLite, Docker, GitLab CI, Gemini.</p></li></ul>",
      "model": "deepseek-v4.1-flash"
    },
