---
import Base from '../layouts/Base.astro';
import DocActions from './DocActions.astro';
import { boardMedia, boardNote, findAlternateProject, overlayFor, projectPath } from '../data/board';
import { strings, otherLang } from '../i18n';
import { getResume, htmlToText, type Lang, type Project } from '../lib/resume';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const resume = getResume(lang);
const t = strings(lang);
const other = otherLang(lang);
const otherResume = getResume(other);
const alt = findAlternateProject(project, resume.projects, otherResume);
const boardHref = lang === 'fr' ? '/' : '/en/';
const overlay = overlayFor(project);
const media = boardMedia(project);
const note = boardNote(project, lang);
const meta = [overlay?.label?.[lang], project.period].filter(Boolean).join(' · ');
const frProject = lang === 'fr' ? project : alt;
const enProject = lang === 'en' ? project : alt;
const frAlt = frProject ? projectPath('fr', frProject.slug) : '/';
const enAlt = enProject ? projectPath('en', enProject.slug) : '/en/';
const title = `${project.name} — ${resume.name}`;
const description = htmlToText(project.description) || meta || resume.headline;
---

<Base lang={lang} title={title} description={description} alternates={{ fr: frAlt, en: enAlt }} zoomable>
  <article id="page" class="open">
    <header class="doc-bar">
      <a class="back" href={`${boardHref}?from=${project.slug}`} data-back-board={boardHref} data-slug={project.slug}>{t.project.back}</a>
      <DocActions lang={lang} t={t} frHref={frAlt} enHref={enAlt} />
    </header>

    <div class="page-inner">
      <figure class="page-media">
        <canvas
          id="pix"
          class="pix"
          width="160"
          height="100"
          data-src={media?.video ?? media?.image ?? ''}
          data-kind={media?.video ? 'video' : media?.image ? 'image' : ''}
        ></canvas>
        <figcaption>{media ? t.project.capture : t.project.noCapture}</figcaption>
      </figure>

      <div class="page-text">
        <span class="stamp">{t.project.stamp}</span>
        <h1>{project.name}</h1>
        {meta && <div class="meta">{meta}</div>}
        {project.description && <div set:html={project.description} />}
        {note && <span class="note">{note.text}</span>}
        {project.website.url && (
          <a class="visit" href={project.website.url} rel="noreferrer">
            {project.website.label || t.project.visit}
          </a>
        )}
      </div>
    </div>
  </article>

  <script>
    import { initPixelPreview } from '../scripts/pixel/preview';
    import { initBackLink } from '../scripts/back';
    initPixelPreview();
    initBackLink();
  </script>
</Base>
