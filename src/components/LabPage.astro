---
import Base from '../layouts/Base.astro';
import DocActions from './DocActions.astro';
import { getBoardPages, pagePath } from '../data/board';
import { EXPERIMENTS } from '../data/lab';
import { strings } from '../i18n';
import { getResume, type Lang } from '../lib/resume';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const resume = getResume(lang);
const t = strings(lang);
const boardHref = lang === 'fr' ? '/' : '/en/';
const page = getBoardPages(lang).find((entry) => entry.id === 'labo')!;
const title = `${t.lab.title} — ${resume.name}`;
---

<Base lang={lang} title={title} description={t.lab.description} alternates={{ fr: pagePath('labo', 'fr'), en: pagePath('labo', 'en') }} zoomable>
  <article id="page" class="open">
    <header class="doc-bar">
      <a class="back" href={`${boardHref}?from=labo`} data-back-board={boardHref} data-slug="labo">{t.lab.back}</a>
      <DocActions lang={lang} t={t} frHref={pagePath('labo', 'fr')} enHref={pagePath('labo', 'en')} />
    </header>

    <div class="page-inner">
      <div class="page-media">
        {EXPERIMENTS.map((experiment) => (
          <figure>
            <div class="pix-box" data-src={experiment.src} data-kind={experiment.kind}>
              <canvas class="pix" width="160" height="100"></canvas>
              <span class="pix-loading">{t.lab.loading}</span>
              <span class="pix-error">{t.lab.unavailable}</span>
            </div>
            <figcaption>{experiment.title[lang]}</figcaption>
          </figure>
        ))}
      </div>

      <div class="page-text">
        <span class="stamp">{t.lab.stamp}</span>
        <h1>{t.lab.title}</h1>
        {EXPERIMENTS.map((experiment) => (
          <section class="experiment">
            <h2>{experiment.title[lang]}</h2>
            <p>{experiment.description[lang]}</p>
          </section>
        ))}
        <span class="note">{page.note.text}</span>
      </div>
    </div>
  </article>

  <script>
    import { initPixelModel } from '../scripts/lab/model';
    import { initBackLink } from '../scripts/back';
    document.querySelectorAll<HTMLElement>('.pix-box[data-kind="pixel-model"]').forEach(initPixelModel);
    initBackLink();
  </script>
</Base>
