---
import Base from '../layouts/Base.astro';
import BoardHud from './BoardHud.astro';
import BoardList from './BoardList.astro';
import { getBoardEntities, getBoardPages, getBoardProjects } from '../data/board';
import { site } from '../data/site';
import { strings } from '../i18n';
import { getResume, htmlToText, type Lang } from '../lib/resume';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const resume = getResume(lang);
const projects = getBoardProjects(resume);
const pages = getBoardPages(lang);
const t = strings(lang);
const cvHref = lang === 'fr' ? '/cv/' : '/en/cv/';
const cvPdf = site.cvPdf[lang];
const [first, ...rest] = resume.name.split(' ');
const nameText = rest.length ? `${first}\n${rest.join(' ')}` : first;
// on a phone the surname breaks after its hyphen
const nameNarrow = nameText.replace(/-/g, '-\n');
const contactHref = resume.email ? `mailto:${resume.email}` : resume.profiles[0]?.url ?? '';
const entities = getBoardEntities(resume, { cvHref, contactHref });

const boardData = {
  name: { l: nameText, p: nameNarrow },
  nameNote: { l: t.board.nameNote, p: t.board.nameNoteNarrow },
  entities: entities.map(({ id, kind, pattern, pad, at }) => ({ id, kind, pattern, pad, at })),
};

const json = JSON.stringify(boardData).replace(/</g, '\\u003c');
const title = t.board.title(resume.name);
const description = htmlToText(resume.summary) || resume.headline;
---

<Base lang={lang} title={title} description={description} alternates={{ fr: '/', en: '/en/' }} zoomable>
  <main>
    <h1 class="sr-only">{resume.name}</h1>
    <div id="stage">
      <canvas id="board" role="img" aria-label={title}></canvas>
      <div id="labels">
        <div class="name-note" id="name-note">{t.board.nameNote}</div>
        {entities.map((entity) => {
          const Tag = entity.url ? 'a' : 'span';
          return (
            <Tag class:list={['ent', `ent-${entity.kind}`]} data-id={entity.id} href={entity.url || undefined}>
              <span class="hit"></span>
              <span class="name">{entity.name}</span>
              <span class="meta">{entity.meta}</span>
            </Tag>
          );
        })}
      </div>
    </div>
  </main>

  <BoardHud lang={lang} t={t} />
  <BoardList lang={lang} t={t} resume={resume} projects={projects} pages={pages} cvHref={cvHref} cvPdf={cvPdf} />

  <noscript>
    <style>
      #stage, .hud { display: none; }
      #list { position: static; transform: none; visibility: visible; width: auto; border-left: 0; }
      html, body { overflow: auto; }
    </style>
  </noscript>

  <script type="application/json" id="board-data" set:html={json}></script>
  <script>
    import { initBoard } from '../scripts/board';
    initBoard();
  </script>
</Base>
