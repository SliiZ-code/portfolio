---
import Base from '../layouts/Base.astro';
import BoardHud from './BoardHud.astro';
import BoardList from './BoardList.astro';
import HomeContent from './home/HomeContent.astro';
import { getBoardProjects, projectPath } from '../data/board';
import { strings } from '../i18n';
import { METHUSELAH_PATTERNS } from '../scripts/board/patterns';
import { cvPdfPath } from '../lib/cv-pdf';
import { boardName } from '../lib/name';
import { getResume, htmlToText, type Lang } from '../lib/resume';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const resume = getResume(lang);
const projects = getBoardProjects(resume);
const t = strings(lang);
const cvHref = lang === 'fr' ? '/cv/' : '/en/cv/';
const cvPdf = cvPdfPath(lang);
const { l: nameText, p: nameNarrow } = boardName(resume.name);

// each row's seed as a tiny pixel glyph, centred in a box sized to the largest pattern so the rows align
const patterns = Object.values(METHUSELAH_PATTERNS) as readonly (readonly (readonly number[])[])[];
const glyphCols = Math.max(...patterns.map((grid) => Math.max(...grid.map((row) => row.length))));
const glyphRows = Math.max(...patterns.map((grid) => grid.length));
const glyphRects = (seed: keyof typeof METHUSELAH_PATTERNS) => {
  const grid = METHUSELAH_PATTERNS[seed] as readonly (readonly number[])[];
  const width = Math.max(...grid.map((row) => row.length));
  const dx = Math.floor((glyphCols - width) / 2);
  const dy = Math.floor((glyphRows - grid.length) / 2);
  const rects: { x: number; y: number }[] = [];
  grid.forEach((row, y) => row.forEach((on, x) => on && rects.push({ x: x + dx, y: y + dy })));
  return rects;
};
const projectCount = String(projects.length).padStart(2, '0');

// the scroll cue's pixel arrow: a 7 × 5 grid, one square per "#"
const ARROW = ['...#...', '...#...', '.#.#.#.', '..###..', '...#...'];
const arrowRects = ARROW.flatMap((row, y) => [...row].flatMap((cell, x) => (cell === '#' ? [{ x, y }] : [])));

const boardData = {
  name: { l: nameText, p: nameNarrow },
};

const json = JSON.stringify(boardData).replace(/</g, '\\u003c');
const title = t.board.title(resume.name);
const description = htmlToText(resume.summary) || resume.headline;
---

<Base lang={lang} title={title} description={description} alternates={{ fr: '/', en: '/en/' }} zoomable>
  <main>
    <h1 class="sr-only">{resume.name}</h1>
    <!-- the home page scrolls: this class (not on the other pages) turns scrolling on; without JavaScript it stays off -->
    <script is:inline>document.documentElement.classList.add('home');</script>
    <div id="stage">
      <canvas id="board" role="img" aria-label={title}></canvas>
      {resume.headline && <div class="name-note" id="name-note">{resume.headline}</div>}
      <!-- the projects: each row fires its seed onto the board, a click dives into its page -->
      <nav id="projects" aria-label={t.board.projects}>
        <p class="phead">{t.board.projects} · {projectCount}</p>
        <ul>
          {projects.map((project) => (
            <li>
              <a class="proj" href={projectPath(lang, project.slug)} data-id={project.slug} data-seed={project.seed}>
                <svg
                  class="pglyph"
                  viewBox={`0 0 ${glyphCols} ${glyphRows}`}
                  style={`--gc:${glyphCols};--gr:${glyphRows}`}
                  shape-rendering="crispEdges"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  {glyphRects(project.seed).map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}
                </svg>
                <span class="pname">{project.boardName}</span>
                {project.meta && <span class="pmeta">{project.meta}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <!-- the board is the hero: the page scrolls over it from here; the cue leads down to the content -->
    <div id="hero-spacer">
      <a class="scroll-cue" href="#content">
        <span>{t.board.scroll}</span>
        <svg viewBox="0 0 7 5" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
          {arrowRects.map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}
        </svg>
      </a>
    </div>
    <HomeContent lang={lang} resume={resume} projects={projects} cvHref={cvHref} cvPdf={cvPdf} />
  </main>

  <BoardHud lang={lang} t={t} profiles={resume.profiles} email={resume.email} cvHref={cvHref} cvPdf={cvPdf} />
  <!-- without JavaScript there is no board: the same content as a plain list -->
  <noscript>
    <style>
      #stage, .hud, #hero-spacer, #content { display: none; }
      html, body { overflow: auto; }
    </style>
    <BoardList lang={lang} t={t} resume={resume} projects={projects} cvHref={cvHref} cvPdf={cvPdf} />
  </noscript>

  <script type="application/json" id="board-data" set:html={json}></script>
  <script>
    import { initBoard } from '../scripts/board';
    initBoard();
  </script>
</Base>
