---
// Decorative still-life divider between sections: a sparse row of Game of Life still lifes in the muted ink, with
// the blinkers in the accent. Drawn by src/scripts/still-life.ts on a canvas; blank without JavaScript.
---

<div class="life-divider" aria-hidden="true">
  <canvas class="life-divider-canvas" aria-hidden="true"></canvas>
</div>

<style>
  /* six cells of 6px (ROW_HEIGHT_CELLS × DIVIDER_CELL in still-life.ts): the height never depends on the board */
  .life-divider {
    display: block;
    width: 100%;
    max-width: 680px;
    height: 36px;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
  }

  .life-divider-canvas {
    display: block;
    image-rendering: pixelated;
  }

  @media (min-width: 900px) {
    .life-divider {
      margin-left: calc(var(--hc-side) + var(--hc-col));
      width: calc(100% - var(--hc-side) - var(--hc-col));
      max-width: 680px;
    }
  }

  @media print {
    .life-divider {
      display: none !important;
    }
  }
</style>

<script>
  import { initLifeDividers } from '../../scripts/still-life';

  initLifeDividers();
</script>
