---
// A section of the page: the pixel title hangs in the left column, the body reads in the right one.
// On a phone the title sits above the body.
import PixelTitle from './PixelTitle.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-title`;
---

<section class="hc-section" id={id} aria-labelledby={headingId}>
  <header class="hc-head">
    <PixelTitle id={headingId} text={title} />
  </header>
  <div class="hc-body">
    <slot />
  </div>
</section>
