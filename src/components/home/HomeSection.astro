---
// A numbered section: the number and a rule sit above a large pixel title, the body follows below.
import PixelTitle from './PixelTitle.astro';

interface Props {
  id: string;
  number: string;
  title: string;
}

const { id, number, title } = Astro.props;
const headingId = `${id}-title`;
---

<section class="hc-section" id={id} aria-labelledby={headingId}>
  <header class="hc-head hc-reveal">
    <p class="hc-num">{number} /</p>
    <PixelTitle id={headingId} text={title} />
  </header>
  <div class="hc-body">
    <slot />
  </div>
</section>

<style>
  /* the title spans the content column: the number, a rule to the right edge, then the word */
  .hc-head {
    display: block;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .hc-num {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 clamp(16px, 2vw, 24px);
  }

  .hc-num::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  /* wide screens: the body starts under the title, at the title's edge, in the 720px reading column */
  @media (min-width: 800px) {
    .hc-section {
      display: block;
    }

    .hc-body {
      max-width: 720px;
    }
  }
</style>
