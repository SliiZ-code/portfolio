---
// The close: one quiet line.
import type { UIStrings } from '../../i18n/fr';
import type { Resume } from '../../lib/resume';

interface Props {
  t: UIStrings;
  resume: Resume;
}

const { t, resume } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="hc-foot">
  <p>© {year} {resume.name}</p>
  <nav aria-label={t.home.footerNav}>
    {resume.email && <a href={`mailto:${resume.email}`}>{resume.email}</a>}
    {resume.profiles.map((profile) => <a href={profile.url}>{profile.network}</a>)}
  </nav>
</footer>
