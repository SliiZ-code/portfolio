---
// The content that scrolls over the fixed board: intro, experience, projects, the rest of the resume, footer.
import '../../styles/home.css';
import HomeAbout from './HomeAbout.astro';
import HomeExperience from './HomeExperience.astro';
import HomeFooter from './HomeFooter.astro';
import HomeIntro from './HomeIntro.astro';
import HomeProjects from './HomeProjects.astro';
import Horizon from './Horizon.astro';
import LifeDivider from './LifeDivider.astro';
import LivingPaper from './LivingPaper.astro';
import type { BoardProject } from '../../data/board';
import { strings } from '../../i18n';
import type { Lang, Resume } from '../../lib/resume';

interface Props {
  lang: Lang;
  resume: Resume;
  projects: BoardProject[];
  cvHref: string;
  cvPdf: string;
}

const { lang, resume, projects, cvHref, cvPdf } = Astro.props;
const t = strings(lang);

const hasExperience = resume.experience.length > 0;
const hasProjects = projects.length > 0;
const hasAbout =
  resume.skills.length > 0 ||
  resume.education.length > 0 ||
  resume.volunteer.length > 0 ||
  resume.languages.length > 0;
---

<section id="content" class="home-content" aria-label={resume.name}>
  <LivingPaper />
  <Horizon />
  <div class="hc">
    <HomeIntro t={t} resume={resume} cvHref={cvHref} cvPdf={cvPdf} />
    {hasExperience && (
      <HomeExperience title={resume.sectionTitles.experience} entries={resume.experience} />
    )}
    {hasExperience && (hasProjects || hasAbout) && <LifeDivider />}
    {hasProjects && (
      <HomeProjects lang={lang} t={t} title={resume.sectionTitles.projects} projects={projects} />
    )}
    {hasProjects && hasAbout && <LifeDivider />}
    <HomeAbout resume={resume} />
    <HomeFooter t={t} resume={resume} />
  </div>
</section>
