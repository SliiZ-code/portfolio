---
// Projects. On a desktop with a mouse: an index of big names, no pictures; each name swells under the pointer.
// Elsewhere: a small picture (or the seed as a poster) beside the name, a line or two and the links. The hidden ones (not on the PDF) follow as a plain list.
import '@fontsource-variable/fraunces/wght.css';
import HomeSection from './HomeSection.astro';
import ProjectMedia from './ProjectMedia.astro';
import { leadSentences, linkLabel, splitProjects } from './content';
import type { BoardProject } from '../../data/board';
import { htmlToText, type Lang } from '../../lib/resume';
import type { UIStrings } from '../../i18n/fr';

interface Props {
  lang: Lang;
  t: UIStrings;
  title: string;
  projects: BoardProject[];
}

const { t, title, projects } = Astro.props;
const { featured, more } = splitProjects(projects);

const leadOf = (project: BoardProject) => leadSentences(htmlToText(project.description), 2);
---

<HomeSection id="hc-projects" title={title}>
  {
    featured.length > 0 && (
      <ul class="hc-projects" data-hover-index>
        {featured.map((project) => (
          <li class="hc-project">
            <div class="hc-media">
              <ProjectMedia project={project} label={project.displayName} />
            </div>
            <div class="hc-project-text">
              <h3 class="hc-entry-title hc-project-name">
                {project.website.url ? <a href={project.website.url}>{project.displayName}</a> : <span>{project.displayName}</span>}
              </h3>
              {project.meta && <p class="hc-date hc-project-meta">{project.meta}</p>}
              {leadOf(project) && <p class="hc-lead">{leadOf(project)}</p>}
              <p class="hc-links">
                {project.website.url && <a href={project.website.url}>{linkLabel(project.website)}</a>}
              </p>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  {
    more.length > 0 && (
      <div class="hc-more">
        <h3 class="hc-label">{t.home.moreProjects}</h3>
        <ul class="hc-plain">
          {more.map((project) => (
            <li>
              {project.website.url ? <a href={project.website.url}>{project.displayName}</a> : project.displayName}
              {project.meta && <span class="hc-date"> {project.meta}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</HomeSection>

<script>
  import { initMagnetType } from '../../scripts/magnet-type';

  document.querySelectorAll<HTMLElement>('[data-hover-index]').forEach(initMagnetType);
</script>
