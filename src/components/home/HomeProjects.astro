---
// Projects in research-homepage format: media, title, meta, one or two sentences, links.
// The hidden ones (not on the PDF) follow as a compact list.
import HomeSection from './HomeSection.astro';
import ProjectMedia from './ProjectMedia.astro';
import { leadSentences, linkLabel, splitProjects } from './content';
import { projectPath, type BoardProject } from '../../data/board';
import { htmlToText, type Lang } from '../../lib/resume';
import type { UIStrings } from '../../i18n/fr';

interface Props {
  lang: Lang;
  t: UIStrings;
  title: string;
  projects: BoardProject[];
}

const { lang, t, title, projects } = Astro.props;
const { featured, more } = splitProjects(projects);

const linksOf = (project: BoardProject) => [
  { href: projectPath(lang, project.slug), label: t.home.projectPage },
  ...(project.website.url ? [{ href: project.website.url, label: linkLabel(project.website) }] : []),
];
const leadOf = (project: BoardProject) => leadSentences(htmlToText(project.description), 2);
---

<HomeSection id="hc-projects" number="02" title={title}>
  <ol class="hc-projects">
    {featured.map((project) => (
      <li class="hc-project hc-reveal">
        <div class="hc-media">
          <ProjectMedia project={project} label={project.displayName} />
        </div>
        <div class="hc-project-text">
          <h3 class="hc-project-name"><a href={projectPath(lang, project.slug)}>{project.displayName}</a></h3>
          {project.meta && <p class="hc-meta">{project.meta}</p>}
          {leadOf(project) && <p class="hc-lead">{leadOf(project)}</p>}
          <p class="hc-links">
            {linksOf(project).map((link, index) => (
              <>
                {index > 0 && ' / '}
                <a href={link.href}>{link.label}</a>
              </>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ol>

  {more.length > 0 && (
    <div class="hc-more hc-reveal">
      <h3>{t.home.moreProjects}</h3>
      <ul>
        {more.map((project) => (
          <li>
            <a class="hc-more-name" href={projectPath(lang, project.slug)}>{project.displayName}</a>
            {project.meta && <span class="hc-meta">{project.meta}</span>}
            <span class="hc-links">
              {linksOf(project).map((link, index) => (
                <>
                  {index > 0 && ' / '}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}
</HomeSection>
