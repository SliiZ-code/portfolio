---
// The rest of the resume, each part as its own section in the same two columns: skills, education, activities,
// languages. Plain lines, the way a CV reads.
import HomeSection from './HomeSection.astro';
import { joinMeta } from './content';
import type { Resume } from '../../lib/resume';

interface Props {
  resume: Resume;
}

const { resume } = Astro.props;
const { sectionTitles: titles } = resume;
---

{
  resume.skills.length > 0 && (
    <HomeSection id="hc-skills" title={titles.skills}>
      <dl class="hc-rows">
        {resume.skills.map((skill) => (
          <div>
            <dt>{skill.name}</dt>
            <dd>{skill.keywords.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </HomeSection>
  )
}

{
  resume.education.length > 0 && (
    <HomeSection id="hc-education" title={titles.education}>
      <ul class="hc-plain">
        {resume.education.map((entry) => (
          <li>
            <span class="hc-entry-title">{joinMeta(entry.degree, entry.area)}</span>
            <span class="hc-line">{entry.school}</span>
            {entry.period && <span class="hc-date">{entry.period}</span>}
          </li>
        ))}
      </ul>
    </HomeSection>
  )
}

{
  resume.volunteer.length > 0 && (
    <HomeSection id="hc-volunteer" title={titles.volunteer}>
      <ul class="hc-plain">
        {resume.volunteer.map((entry) => (
          <li>
            <span class="hc-entry-title">{entry.organization}</span>
            {entry.period && <span class="hc-date">{entry.period}</span>}
          </li>
        ))}
      </ul>
    </HomeSection>
  )
}

{
  resume.languages.length > 0 && (
    <HomeSection id="hc-languages" title={titles.languages}>
      <ul class="hc-plain">
        {resume.languages.map((entry) => (
          <li>
            <span class="hc-entry-title">{entry.language}</span>
            {entry.fluency && <span class="hc-date">{entry.fluency}</span>}
          </li>
        ))}
      </ul>
    </HomeSection>
  )
}
