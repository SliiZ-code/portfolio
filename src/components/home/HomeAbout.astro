---
// The compact part: skills as plain tags under their names, then education, activities and languages in columns.
import HomeSection from './HomeSection.astro';
import { joinMeta } from './content';
import type { UIStrings } from '../../i18n/fr';
import type { Resume } from '../../lib/resume';

interface Props {
  t: UIStrings;
  resume: Resume;
}

const { t, resume } = Astro.props;
const { sectionTitles: titles } = resume;
---

<HomeSection id="hc-about" number="03" title={t.home.about}>
  <div class="hc-about">
    {resume.skills.length > 0 && (
      <div class="hc-block hc-reveal">
        <h3>{titles.skills}</h3>
        <ul class="hc-skills">
          {resume.skills.map((skill) => (
            <li>
              <h4 class="hc-skill-name">{skill.name}</h4>
              {skill.keywords.length > 0 && <p class="hc-keywords">{skill.keywords.join(' / ')}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="hc-columns">
      {resume.education.length > 0 && (
        <div class="hc-block hc-reveal">
          <h3>{titles.education}</h3>
          <ul>
            {resume.education.map((entry) => (
              <li>
                <span class="hc-strong">{entry.school}</span>
                <span class="hc-line">{joinMeta(entry.degree, entry.area)}</span>
                {entry.period && <span class="hc-meta">{entry.period}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}

      {resume.volunteer.length > 0 && (
        <div class="hc-block hc-reveal">
          <h3>{titles.volunteer}</h3>
          <ul>
            {resume.volunteer.map((entry) => (
              <li>
                <span class="hc-strong">{entry.organization}</span>
                {entry.period && <span class="hc-meta">{entry.period}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}

      {resume.languages.length > 0 && (
        <div class="hc-block hc-reveal">
          <h3>{titles.languages}</h3>
          <ul>
            {resume.languages.map((entry) => (
              <li>
                <span class="hc-strong">{entry.language}</span>
                {entry.fluency && <span class="hc-meta">{entry.fluency}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</HomeSection>
