---
// The horizon (src/scripts/horizon.ts): a tide of dither cells where the board meets the paper, at the top of the
// content and again at the bottom. Decorative and hidden until the script runs; without it the static band in
// home.css stays.
---

<div class="hz hz-top" aria-hidden="true"><canvas hidden></canvas></div>
<div class="hz hz-bottom" aria-hidden="true"><canvas hidden></canvas></div>
<div class="hz-grid hz-grid-top" aria-hidden="true"></div>
<div class="hz-grid hz-grid-bottom" aria-hidden="true"></div>

<style>
  .hz {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--dissolve);
    overflow: hidden;
    pointer-events: none;
  }

  .hz-top {
    top: 0;
  }

  .hz-bottom {
    bottom: 0;
  }

  .hz canvas {
    display: block;
    image-rendering: pixelated;
  }

  .hz-bottom canvas {
    position: absolute;
    bottom: 0;
  }

  /* the board's grid does not stop where the paper starts: it runs on under the dither and fades out over the first
     screen of text, so the tide lands on fading lines, not on a flat block. It fades in across the band as the paper
     takes over (the holes already show the board's grid). Fixed, so the lines sit on the board's own */
  .hz-grid {
    position: absolute;
    left: 0;
    right: 0;
    height: calc(var(--dissolve) + min(55vh, 480px));
    pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: var(--c, 3px) var(--c, 3px);
    background-attachment: fixed;
  }

  .hz-grid-top {
    top: 0;
    -webkit-mask-image: linear-gradient(transparent, #000 var(--dissolve), rgb(0 0 0 / .55) calc(var(--dissolve) + 40px), transparent);
    mask-image: linear-gradient(transparent, #000 var(--dissolve), rgb(0 0 0 / .55) calc(var(--dissolve) + 40px), transparent);
  }

  .hz-grid-bottom {
    bottom: 0;
    -webkit-mask-image: linear-gradient(to top, transparent, #000 var(--dissolve), rgb(0 0 0 / .55) calc(var(--dissolve) + 40px), transparent);
    mask-image: linear-gradient(to top, transparent, #000 var(--dissolve), rgb(0 0 0 / .55) calc(var(--dissolve) + 40px), transparent);
  }

  /* a touch screen scrolls the lines with the text: iOS ignores a fixed background anyway, and elsewhere it would
     repaint both layers on every scroll frame */
  @media (hover: none) {
    .hz-grid {
      background-attachment: scroll;
    }
  }

  @media print {
    .hz-grid,
    .hz {
      display: none;
    }
  }
</style>

<script>
  import { initHorizon } from '../../scripts/horizon';

  document.querySelectorAll<HTMLCanvasElement>('.hz canvas').forEach((canvas, i) => {
    try {
      initHorizon(canvas, i === 1, i * 2.3);
    } catch {
      // decoration: the static band in home.css stays
    }
  });
</script>
