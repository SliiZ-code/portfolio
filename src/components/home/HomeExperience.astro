---
// Experience: each job as a short entry, the role and the place on one line, the dates beside them, then the text
// from the resume.
import HomeSection from './HomeSection.astro';
import { joinMeta } from './content';
import type { Experience } from '../../lib/resume';

interface Props {
  title: string;
  entries: Experience[];
}

const { title, entries } = Astro.props;
---

<HomeSection id="hc-experience" title={title}>
  <div class="hc-entries">
    {
      entries.map((entry) => (
        <article class="hc-entry">
          <header class="hc-entry-head">
            <h3 class="hc-entry-title">
              {entry.position || entry.company}{entry.company && entry.position && ', '}{entry.company && entry.position && (entry.website.url ? <a href={entry.website.url}>{entry.company}</a> : entry.company)}
            </h3>
            <p class="hc-date">{joinMeta(entry.period, entry.location)}</p>
          </header>
          {entry.description && <div class="hc-desc" set:html={entry.description} />}
          {entry.roles.map((role) => (
            <div class="hc-sub">
              <h4 class="hc-entry-title">{role.position}</h4>
              {role.period && <p class="hc-date">{role.period}</p>}
              {role.description && <div class="hc-desc" set:html={role.description} />}
            </div>
          ))}
        </article>
      ))
    }
  </div>
</HomeSection>
