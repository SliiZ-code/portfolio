---
// The opening: the bio as one paragraph, then the ways to reach out, as plain links.
import type { UIStrings } from '../../i18n/fr';
import { htmlToText, type Resume } from '../../lib/resume';

interface Props {
  t: UIStrings;
  resume: Resume;
  cvHref: string;
  cvPdf: string;
}

const { t, resume, cvHref, cvPdf } = Astro.props;
const bio = htmlToText(resume.summary);
---

<div class="hc-intro">
  {bio && <p class="hc-summary">{bio}</p>}
  <p class="hc-reach">
    {resume.email && <a href={`mailto:${resume.email}`}>{resume.email}</a>}
    <a href={cvPdf || cvHref} type={cvPdf ? 'application/pdf' : undefined}>{cvPdf ? t.home.cvPdf : t.home.cv}</a>
    {resume.profiles.map((profile) => <a href={profile.url}>{profile.network}</a>)}
  </p>
</div>

<script>
  import { initFlowText } from '../../scripts/flow-text';

  document.querySelectorAll<HTMLElement>('.hc-summary').forEach(initFlowText);
</script>
