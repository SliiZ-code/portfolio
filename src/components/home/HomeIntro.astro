---
// The opening: the bio as one paragraph, then the ways to reach out, as plain links.
import type { UIStrings } from '../../i18n/fr';
import { htmlToText, type Resume } from '../../lib/resume';

interface Props {
  t: UIStrings;
  resume: Resume;
  cvHref: string;
  cvPdf: string;
}

const { t, resume, cvHref, cvPdf } = Astro.props;
const bio = htmlToText(resume.summary);
---

<div class="hc-intro">
  {bio && <p class="hc-summary">{bio}</p>}
  <p class="hc-reach">
    {resume.email && <a href={`mailto:${resume.email}`}>{resume.email}</a>}
    <a href={cvPdf || cvHref} type={cvPdf ? 'application/pdf' : undefined}>{cvPdf ? t.home.cvPdf : t.home.cv}</a>
    {resume.profiles.map((profile) => <a href={profile.url}>{profile.network}</a>)}
  </p>
</div>

<script>
  // the flowing text is for a fine pointer only: its module (pretext's tables are most of it) loads only there, so a phone
  // never downloads it. The same query as flow-text.ts; reduced motion is left to that module, which follows it live.
  const paragraphs = document.querySelectorAll<HTMLElement>('.hc-summary');
  if (paragraphs.length && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    import('../../scripts/flow-text').then(({ initFlowText }) => paragraphs.forEach(initFlowText));
  }
</script>
