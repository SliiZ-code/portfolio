---
import LangFlags from './LangFlags.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { UIStrings } from '../i18n/fr';
import type { Lang, Profile } from '../lib/resume';

interface Props {
  lang: Lang;
  t: UIStrings;
  profiles: Profile[];
  email: string;
  /** The HTML CV page: the fallback while there is no PDF. */
  cvHref: string;
  cvPdf: string;
}

const { t, profiles, email, cvHref, cvPdf, lang } = Astro.props;
---

<div class="hud tl">{t.board.home}</div>

<div class="hud tr">
  <LangFlags t={t} lang={lang} frHref="/" enHref="/en/" />
  <span class="sep"></span>
  <ThemeToggle t={t} />
</div>

<div class="hud bl">
  <span>{t.board.generation} <b id="gen">0000</b> · <b id="pop">0</b> {t.board.cells}</span>
  <span class="hint">{t.board.hint}</span>
</div>

<nav class="hud br" aria-label={t.board.elsewhere}>
  {profiles.map((profile) => <a href={profile.url}>{profile.network}</a>)}
  {email && <a class="cta" href={`mailto:${email}`}>{t.board.contact}</a>}
  <a class="cta" href={cvPdf || cvHref} type={cvPdf ? 'application/pdf' : undefined}>{t.board.cv}</a>
</nav>
