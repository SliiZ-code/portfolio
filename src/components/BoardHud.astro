---
import LangFlags from './LangFlags.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { UIStrings } from '../i18n/fr';
import type { Lang } from '../lib/resume';

interface Props {
  lang: Lang;
  t: UIStrings;
}

const { lang, t } = Astro.props;
---

<div class="hud tl">{t.board.home}</div>

<div class="hud tr">
  <LangFlags t={t} lang={lang} frHref="/" enHref="/en/" />
  <span class="sep"></span>
  <ThemeToggle t={t} />
</div>

<div class="hud bl">
  <span>{t.board.generation} <b id="gen">0000</b> · <b id="pop">0</b> {t.board.cells}</span>
  <span class="hint">{t.board.hint}</span>
</div>

<div class="hud br">
  <button type="button" id="list-btn" aria-controls="list" aria-expanded="false">{t.board.openList}</button>
</div>
