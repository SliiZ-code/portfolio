---
import LangFlags from './LangFlags.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { UIStrings } from '../i18n/fr';
import type { Lang } from '../lib/resume';

interface Props {
  lang: Lang;
  t: UIStrings;
  frHref: string;
  enHref: string;
  pdfHref?: string;
  print?: boolean;
}

const { lang, t, frHref, enHref, pdfHref, print } = Astro.props;
---

<div class="doc-actions">
  {pdfHref && <a href={pdfHref}>{t.cv.pdf}</a>}
  {print && <button type="button" data-print>{t.cv.print}</button>}
  <LangFlags t={t} lang={lang} frHref={frHref} enHref={enHref} />
  <span class="sep"></span>
  <ThemeToggle t={t} />
</div>
