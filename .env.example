# RxResume: the one French resume. The English and the CV PDFs are generated from it.
# Copy to .env and fill in; never commit .env. See docs/resume-sync.md.
RXRESUME_URL=https://rxresu.me
RXRESUME_API_KEY=
RXRESUME_ID=

# AI translation of the resume (first configured provider wins: Claude, then Gemini, then OpenRouter)
# Claude subscription: the token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
TRANSLATE_CLAUDE_MODEL=
TRANSLATE_GEMINI_MODEL=
TRANSLATE_OPENROUTER_MODEL=

# Local development only: use the Claude Code login of this machine (1) instead of a token
TRANSLATE_CLAUDE_LOCAL=
