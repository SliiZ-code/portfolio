# RxResume public resume API (v6).
# Copy this file to .env and fill in the values before `npm run sync:resume`.
RXRESUME_URL=https://rxresu.me
RXRESUME_API_KEY=
RXRESUME_ID_FR=
RXRESUME_ID_EN=
# Optional: one dedicated "web" resume per language, used only for the public CV PDF. Each sync
# OVERWRITES them with the main resumes minus the phone: never put a main resume ID here, and use
# two different resumes. Leave empty to publish no PDF.
RXRESUME_PDF_ID_FR=
RXRESUME_PDF_ID_EN=
