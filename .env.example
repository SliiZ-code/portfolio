# RxResume public resume API (v6).
# Copy this file to .env and fill in the values before `npm run sync:resume`.
RXRESUME_URL=https://rxresu.me
RXRESUME_API_KEY=
RXRESUME_ID_FR=
RXRESUME_ID_EN=
# Optional: the "web" copies of the resumes (without the phone number), used only for the
# public CV PDF. Leave empty to publish no PDF.
RXRESUME_PDF_ID_FR=
RXRESUME_PDF_ID_EN=
