:80 {
  root * /srv

  encode zstd gzip

  try_files {path} {path}/ {path}.html

  # Every response gets exactly one Cache-Control. These are handle blocks: the first matching one serves the
  # request, and the last one (no matcher) takes every other path. No top-level header, so nothing is set twice.

  # Content-hashed Astro bundles: the file name changes with the content, so a year is safe
  handle /_astro/* {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  # Fixed-name assets that only change by hand: a day, then ETag revalidation
  handle /media/* {
    header Cache-Control "public, max-age=86400"
    file_server
  }

  handle /fonts/* {
    header Cache-Control "public, max-age=86400"
    file_server
  }

  # Fixed-name images that only change by hand (social card, icons): a day. A new image shows within a day
  # on a phone, and the ETag makes the revalidation a 304 when nothing changed.
  @brand path /og.png /apple-touch-icon.png /favicon.svg
  handle @brand {
    header Cache-Control "public, max-age=86400"
    file_server
  }

  # Regenerated on every deploy, so a browser must ask every time (cheap 304 through the ETag).
  # The autodeploy checker reads the fingerprint after each deploy: it must never be a cached copy.
  @generated path /robots.txt /sitemap*.xml /resume-fingerprint.json
  handle @generated {
    header Cache-Control "no-cache"
    file_server
  }

  # Default: HTML pages, the CV PDFs (/cv/*.pdf, which the owner replaces on each resume change) and anything
  # else. The browser may store them but must revalidate on every visit, so a redeploy shows at once.
  handle {
    header Cache-Control "no-cache"
    file_server
  }

  # Error handling: override cache for error responses
  handle_errors {
    header Cache-Control "no-cache"
    encode zstd gzip
    rewrite * /404.html
    file_server
  }
}
